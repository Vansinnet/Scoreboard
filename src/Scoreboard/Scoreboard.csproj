<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../config/paths.local.props" Condition="Exists('../../config/paths.local.props')" />
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Version>0.1.0</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="BepInEx" HintPath="$(BepInExRoot)/core/BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExRoot)/core/0Harmony.dll" Private="false" />
    <Reference Include="assembly_valheim" HintPath="$(ValheimManaged)/assembly_valheim.dll" Private="false" />
    <Reference Include="assembly_utils" HintPath="$(ValheimManaged)/assembly_utils.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ValheimManaged)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ValheimManaged)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ValheimManaged)/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(ValheimManaged)/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(ValheimManaged)/Newtonsoft.Json.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckLocalReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ValheimManaged)/assembly_valheim.dll')" Text="Set ValheimManaged in config/paths.local.props." />
    <Error Condition="!Exists('$(BepInExRoot)/core/BepInEx.dll')" Text="Set BepInExRoot in config/paths.local.props." />
  </Target>
</Project>
